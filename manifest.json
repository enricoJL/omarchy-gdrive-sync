{
  "schemaVersion": 1,
  "id": "com.github.enricojl.gdrive-sync",
  "name": "Google Drive",
  "version": "0.1.0",
  "author": "Enrico Lévesque",
  "license": "MIT",
  "repository": "https://github.com/enricojl/omarchy-gdrive-sync",
  "description": "Two-way Google Drive sync with rclone bisync: bar status, live progress, visible problems, folder picker. (UI in French)",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Google Drive",
    "description": "Indicateur de synchronisation Google Drive (rclone bisync) avec panneau de suivi et de contrôle.",
    "category": "Files",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "remote": "gdrive:",
      "localDir": "~/GoogleDrive",
      "intervalSec": 60,
      "refreshIntervalSec": 15
    },
    "schema": [
      {
        "key": "remote",
        "type": "string",
        "label": "Distant rclone (ex. gdrive: ou gdrive:Dossier)",
        "defaultValue": "gdrive:"
      },
      {
        "key": "localDir",
        "type": "string",
        "label": "Dossier local à synchroniser",
        "defaultValue": "~/GoogleDrive"
      },
      {
        "key": "intervalSec",
        "type": "integer",
        "label": "Intervalle entre les synchronisations (secondes)",
        "min": 30,
        "max": 3600,
        "step": 30,
        "defaultValue": 60
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Rafraîchissement de l'état (secondes)",
        "min": 5,
        "max": 300,
        "step": 5,
        "defaultValue": 15
      }
    ]
  }
}
